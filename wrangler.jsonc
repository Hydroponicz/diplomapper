{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "diplomapper",
  "compatibility_date": "2026-09-29",
  "main": "./worker/index.ts",
  "assets": {
    // Built by `npm run build` before deploy (Workers Builds runs the build command first).
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served as static files without running the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Branch previews: every non-production branch gets its own *.workers.dev Preview URL
  // when preview builds are enabled in Workers Builds. Previews never change production.
  "preview_urls": true,
  "previews": {}
}
